class Solution {
private:
    // Helper function to calculate the determinant of an NxN matrix
    int getDeterminant(vector<vector<int>>& mat, int n) {
        // Base cases
        if (n == 1) return mat[0][0];
        if (n == 2) return mat[0][0] * mat[1][1] - mat[0][1] * mat[1][0];
        
        int det = 0;
        int sign = 1;
        vector<vector<int>> submat(n - 1, vector<int>(n - 1));
        
        // Cofactor expansion along the first row
        for (int c = 0; c < n; c++) {
            int subi = 0;
            for (int i = 1; i < n; i++) {
                int subj = 0;
                for (int j = 0; j < n; j++) {
                    if (j == c) continue;
                    submat[subi][subj] = mat[i][j];
                    subj++;
                }
                subi++;
            }
            det += sign * mat[0][c] * getDeterminant(submat, n - 1);
            sign = -sign;
        }
        return det;
    }

public:
    // Renamed function and adjusted parameters to match the GFG backend driver
    int countSpanTree(int n, vector<vector<int>>& edges) {
        // A graph with 1 vertex already acts as its own spanning tree
        if (n == 1) return 1;
        
        // Step 1: Build the Laplacian Matrix
        // L[i][i] = degree of vertex i
        // L[i][j] = -1 if there is an edge between i and j, 0 otherwise
        vector<vector<int>> laplacian(n, vector<int>(n, 0));
        
        for (auto& edge : edges) {
            int u = edge[0];
            int v = edge[1];
            
            laplacian[u][u]++;
            laplacian[v][v]++;
            laplacian[u][v]--;
            laplacian[v][u]--;
        }
        
        // Step 2: Create a cofactor matrix by removing the last row and last column
        vector<vector<int>> cofactor(n - 1, vector<int>(n - 1));
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - 1; j++) {
                cofactor[i][j] = laplacian[i][j];
            }
        }
        
        // Step 3: The answer is the determinant of this cofactor matrix
        return getDeterminant(cofactor, n - 1);
    }
};
