class Solution {
public:
    // Returns sum of bitwise XOR of all pairs
    long long int sumXOR(vector<int>& arr) {
        long long int total_sum = 0;
        int n = arr.size(); // Extract size from the vector
        
        // Iterate over each bit position (from 0 to 31)
        for (int i = 0; i < 32; i++) {
            long long int count_set_bits = 0;
            long long int count_unset_bits = 0;
            
            // Count elements with i-th bit set and unset
            for (int j = 0; j < n; j++) {
                if (arr[j] & (1 << i)) {
                    count_set_bits++;
                } else {
                    count_unset_bits++;
                }
            }
            
            // Number of pairs where this bit is different
            long long int valid_pairs = count_set_bits * count_unset_bits;
            
            // Contribution of this bit to the total sum
            total_sum += valid_pairs * (1LL << i);
        }
        
        return total_sum;
    }
};
