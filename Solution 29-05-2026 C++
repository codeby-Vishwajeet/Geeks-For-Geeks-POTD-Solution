#include <iostream>
#include <string>
#include <vector>

using namespace std;

class Solution {
private:
    int dp[105][905];

    int solve(int idx, int prev_sum, const string& s) {
        // Base Case: Reached the end of the string successfully
        if (idx == s.length()) {
            return 1;
        }
        
        // Return precalculated results
        if (dp[idx][prev_sum] != -1) {
            return dp[idx][prev_sum];
        }

        int curr_sum = 0;
        int ans = 0;
        
        // Try all possible substrings starting from idx
        for (int i = idx; i < s.length(); ++i) {
            curr_sum += (s[i] - '0'); // Convert char to int
            
            // If the current group sum is valid, recurse for the remaining string
            if (curr_sum >= prev_sum) {
                ans += solve(i + 1, curr_sum, s);
            }
        }
        
        // Store and return the result
        return dp[idx][prev_sum] = ans;
    }

public:
    // Renamed to validGroups to match what the GfG driver code expects
    int validGroups(string s) {
        // Initialize DP table with -1
        for(int i = 0; i <= s.length(); i++) {
            for(int j = 0; j <= 900; j++) {
                dp[i][j] = -1;
            }
        }
        
        return solve(0, 0, s);
    }
};    
