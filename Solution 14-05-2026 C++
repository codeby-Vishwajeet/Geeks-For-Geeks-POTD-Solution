#include <vector>

using namespace std;

class Solution {
public:
    // Renamed from 'searchSubarray' to 'search' to match GFG's driver code
    vector<int> search(vector<int>& a, vector<int>& b) {
        int n = a.size();
        int m = b.size();
        vector<int> result;

        if (m == 0 || n < m) {
            return result;
        }

        // Step 1: Preprocess the pattern b[] to create the LPS array
        vector<int> lps(m, 0);
        int len = 0; 
        int i = 1;
        
        while (i < m) {
            if (b[i] == b[len]) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        // Step 2: Perform the KMP Search
        i = 0; 
        int j = 0; 
        
        while (i < n) {
            if (a[i] == b[j]) {
                i++;
                j++;
            }

            if (j == m) {
                result.push_back(i - j); 
                j = lps[j - 1]; 
            } else if (i < n && a[i] != b[j]) {
                if (j != 0) {
                    j = lps[j - 1]; 
                } else {
                    i++; 
                }
            }
        }

        return result;
    }
};
