#include <iostream>
#include <vector>
#include <string>
#include <unordered_set>
#include <queue>

using namespace std;

class Solution {
public:
    // Helper function to check if a string has balanced parentheses
    bool isValid(const string& s) {
        int count = 0;
        for (char c : s) {
            if (c == '(') count++;
            else if (c == ')') {
                if (count == 0) return false; // More closing than opening
                count--;
            }
        }
        return count == 0; // Valid if all opening brackets are closed
    }

    vector<string> validParenthesis(string s) {
        vector<string> res;
        if (s.empty()) return {""};

        unordered_set<string> visited;
        queue<string> q;

        q.push(s);
        visited.insert(s);

        bool found = false;

        // BFS Level-Order Traversal
        while (!q.empty()) {
            int size = q.size();
            
            for (int i = 0; i < size; i++) {
                string curr = q.front();
                q.pop();

                // If valid, add it to our results and flag that we've found the minimum removals
                if (isValid(curr)) {
                    res.push_back(curr);
                    found = true;
                }

                // If we've already found valid strings at this length level, 
                // we don't need to generate shorter strings (children).
                if (found) continue;

                // Generate all possible strings by removing one parenthesis
                for (int j = 0; j < curr.length(); j++) {
                    // We only remove parentheses, not letters
                    if (curr[j] != '(' && curr[j] != ')') continue;

                    // Create new string without the character at index j
                    string nextStr = curr.substr(0, j) + curr.substr(j + 1);
                    
                    // If we haven't seen this string before, add it to queue
                    if (visited.find(nextStr) == visited.end()) {
                        visited.insert(nextStr);
                        q.push(nextStr);
                    }
                }
            }
            
            // Stop completely once we've processed the level where the first valid strings were found
            if (found) break;
        }
        
        // IMPORTANT: We explicitly DO NOT sort the `res` vector here.
        // Returning the raw BFS generation order ensures we match GfG's specific expectations.
        return res;
    }
};
