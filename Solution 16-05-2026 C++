#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
  public:
    long long findSmallest(vector<int>& arr) {
        // Step 1: Sort the array in ascending order
        sort(arr.begin(), arr.end());
        
        // Step 2: Initialize the smallest unrepresentable sum
        long long res = 1; 
        
        // Step 3: Traverse the sorted array
        for (int i = 0; i < arr.size(); i++) {
            // If the current element is greater than the smallest missing sum,
            // we have found our gap.
            if (arr[i] > res) {
                break;
            }
            // Otherwise, expand the range of sums we can form
            res += arr[i];
        }
        
        return res;
    }
};
