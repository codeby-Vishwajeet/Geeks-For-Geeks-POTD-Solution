class Solution {
public:
    // Renamed to match the expected driver code exactly
    int minToggle(vector<int>& arr) {
        int totalZeros = 0;
        
        // Count total number of 0s
        for (int x : arr) {
            if (x == 0) {
                totalZeros++;
            }
        }
        
        int current_cost = totalZeros;
        int min_cost = totalZeros;
        
        // Iterate through the array and dynamically update the cost
        for (int i = 0; i < arr.size(); i++) {
            if (arr[i] == 1) {
                current_cost++;
            } else {
                current_cost--;
            }
            
            min_cost = min(min_cost, current_cost);
        }
        
        return min_cost;
    }
};
