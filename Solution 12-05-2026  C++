#include <iostream>
#include <vector>
#include <numeric>

using namespace std;

class Solution {
private:
    // Helper function to calculate LCM safely using long long to avoid overflow
    long long getLcm(long long a, long long b) {
        if (a == 0 || b == 0) return 0;
        return (a / std::gcd(a, b)) * b;
    }

    void build(int node, int start, int end, vector<int>& arr, vector<long long>& tree) {
        if (start == end) {
            tree[node] = arr[start];
            return;
        }
        int mid = start + (end - start) / 2;
        build(2 * node + 1, start, mid, arr, tree);
        build(2 * node + 2, mid + 1, end, arr, tree);
        
        // Internal node stores LCM of its children
        tree[node] = getLcm(tree[2 * node + 1], tree[2 * node + 2]);
    }

    void update(int node, int start, int end, int idx, int val, vector<long long>& tree) {
        if (start == end) {
            tree[node] = val;
            return;
        }
        int mid = start + (end - start) / 2;
        if (start <= idx && idx <= mid) {
            update(2 * node + 1, start, mid, idx, val, tree);
        } else {
            update(2 * node + 2, mid + 1, end, idx, val, tree);
        }
        
        // Update current node after children are updated
        tree[node] = getLcm(tree[2 * node + 1], tree[2 * node + 2]);
    }

    long long query(int node, int start, int end, int l, int r, vector<long long>& tree) {
        // Completely outside the range
        if (r < start || end < l) {
            return 1; // 1 is the identity element for LCM
        }
        // Completely inside the range
        if (l <= start && end <= r) {
            return tree[node];
        }
        // Partially inside and partially outside
        int mid = start + (end - start) / 2;
        long long left_lcm = query(2 * node + 1, start, mid, l, r, tree);
        long long right_lcm = query(2 * node + 2, mid + 1, end, l, r, tree);
        
        return getLcm(left_lcm, right_lcm);
    }

public:
    // Updated function name and return type to match the driver code
    vector<long long> RangeLCMQuery(vector<int>& arr, vector<vector<int>>& queries) {
        int n = arr.size();
        
        // Segment tree array (size 4*N is safe)
        vector<long long> tree(4 * n);
        build(0, 0, n - 1, arr, tree);

        vector<long long> result; 
        
        for (auto& q : queries) {
            if (q[0] == 1) {
                // Type 1: Update query -> [1, index, value]
                update(0, 0, n - 1, q[1], q[2], tree);
            } else if (q[0] == 2) {
                // Type 2: Range query -> [2, L, R]
                result.push_back(query(0, 0, n - 1, q[1], q[2], tree));
            }
        }
        
        return result;
    }
};
